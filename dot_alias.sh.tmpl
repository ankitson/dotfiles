# 1Password interactive helper (provides op_exec_interactive for safe secret injection)
[ -f "$HOME/.op_helper.sh" ] && source "$HOME/.op_helper.sh"

# Interactive mode: use the regular Claude Code login (no token injection)
claudep() {
  claude --allow-dangerously-skip-permissions "$@"
}
{{ else if eq .identity "agent" -}}
# Agent mode: service account token is already in env, op read works directly
claudep() {
  CLAUDE_CODE_OAUTH_TOKEN="$(op read "op://clankers/anthropic-claude-code-setup-token/password")" \
    claude --allow-dangerously-skip-permissions "$@"
}
{{ end -}}

claudeb() {
  claude --settings "$HOME/.claude/bifrost-settings.json" --allow-dangerously-skip-permissions "$@"
}

