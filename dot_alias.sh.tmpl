# search everywhere except mnts, and limit matches and output to not flood screen
rgs() {
  rg \
    --hidden \
    --no-ignore \
    --one-file-system \
    --no-messages \
    --max-count 3 \
    --max-columns 200 \
    --max-columns-preview \
    "$@"
